{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Aegis AI",
  "version": "0.1.0",
  "identifier": "com.aegis.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aegis AI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#FFFFFF",
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "publisher": "Aegis AI",
    "category": "Utility",
    "shortDescription": "Secure cross-platform AI assistant",
    "longDescription": "Aegis AI is a cross-platform (Linux/Windows) AI assistant with multi-provider AI connections, computer-use capabilities, persistent memory, and built-in security defense.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "MIT License",
    "homepage": "https://github.com/hieulouisdev/Axiom"
  }
}
